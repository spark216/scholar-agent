# Copy to .env and fill secrets before starting app profile.
# Infra-only mode does not require API keys.

# --- Required for app profile ---
ZHIPUAI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
SEMANTIC_SCHOLAR_ENABLED=1
# Optional but strongly recommended; unauthenticated traffic is more easily throttled.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.0
# 第二轮最多沿 1 篇高置信种子论文做一次一跳引文扩展；不建立全库向量索引。
SEMANTIC_SCHOLAR_CITATION_EXPANSION_ENABLED=1
SEMANTIC_SCHOLAR_CITATION_EXPANSION_REQUIRE_API_KEY=1
SEMANTIC_SCHOLAR_CITATION_EXPANSION_LIMIT=20
OPENALEX_API_KEY=
NCBI_API_KEY=
NCBI_TOOL=huawei-paper-search
NCBI_EMAIL=
ACADEMIC_MIN_CANDIDATES=50
ACADEMIC_REQUIRE_MIN_CANDIDATES=0
ACADEMIC_PROVIDER_LIMIT=40
ACADEMIC_REQUEST_TIMEOUT=20
ACADEMIC_CONNECT_TIMEOUT=5
ACADEMIC_POOL_TIMEOUT=2
ACADEMIC_REQUEST_MAX_ATTEMPTS=2
ACADEMIC_RETRY_BACKOFF_SECONDS=0.35
ACADEMIC_CIRCUIT_FAILURE_THRESHOLD=2
ACADEMIC_CIRCUIT_COOLDOWN_SECONDS=120
ACADEMIC_HTTP_MAX_CONNECTIONS=24
ACADEMIC_HTTP_MAX_KEEPALIVE_CONNECTIONS=12
# PaSa 的 id2paper.json 只包含论文语料元数据，不包含逐查询 gold 标注。
# 留空时会自动检查 PAPER_TEST_DATASET_ROOT 和 ~/Downloads/paper-dataset。
ACADEMIC_LOCAL_CORPUS_ENABLED=1
ACADEMIC_LOCAL_CORPUS_PATH=
ACADEMIC_LOCAL_INDEX_PATH=
ACADEMIC_LOCAL_DOCUMENTS_PATH=
ACADEMIC_LOCAL_ABSTRACT_MAX_CHARS=4000
ACADEMIC_LOCAL_PROVIDER_LIMIT=100
# 先运行 backend/scripts/build_pasa_vector_index.py，完成后再开启。
ACADEMIC_LOCAL_VECTOR_ENABLED=0
ACADEMIC_LOCAL_VECTOR_COLLECTION=pasa_full_corpus_bge_m3
ACADEMIC_LOCAL_VECTOR_PROVIDER_LIMIT=80
ACADEMIC_LOCAL_VECTOR_RECALL_LIMIT=120
AGENT_SEARCH_MAX_ITERATIONS=2
AGENT_SEARCH_ROUND_TARGET=40
AGENT_SEARCH_MIN_NEW_CANDIDATES=5
AGENT_SEARCH_MIN_COVERAGE=0.6
AGENT_SEARCH_MAX_API_CALLS=12
AGENT_SEARCH_LLM_EVOLUTION_ENABLED=1
AGENT_SEARCH_LLM_EVOLUTION_MAX_CALLS=1
AGENT_SEARCH_LLM_EVOLUTION_MAX_TOKENS=240
AGENT_SEARCH_LLM_EVOLUTION_PROMPT_VERSION=adaptive-query-v1
AGENT_SEARCH_TAVILY_LIMIT=20
AGENT_SEARCH_TAVILY_CONDITIONAL=1
AGENT_SEARCH_TAVILY_MIN_ACADEMIC_CANDIDATES=50
AGENT_SEARCH_TAVILY_MIN_COVERAGE=0.8
ACADEMIC_PROVIDER_CACHE_ENABLED=1
ACADEMIC_PROVIDER_CACHE_TTL_SECONDS=604800
ACADEMIC_PROVIDER_CACHE_PATH=

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=huawei-paper-search
POSTGRES_PORT=5432
POSTGRES_URI=postgresql://postgres:postgres@127.0.0.1:5432/huawei-paper-search

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --- Milvus ---
MILVUS_URI=http://127.0.0.1:19530
MILVUS_PORT=19530
MILVUS_COLLECTION=paper_search_bge_m3
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Local BGE ---
BGE_M3_MODEL_PATH=BAAI/bge-m3
BGE_M3_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
BGE_MODEL_CACHE_DIR=
BGE_LOCAL_FILES_ONLY=0
BGE_M3_DEVICE=cpu
BGE_M3_USE_FP16=0
BGE_M3_BATCH_SIZE=8
BGE_M3_MAX_LENGTH=512
BGE_EMBEDDING_CACHE_SIZE=4096
BGE_ALLOW_HASH_FALLBACK=0
BGE_M3_CANDIDATE_LIMIT=80
BGE_M3_MAX_CANDIDATE_LIMIT=100
BGE_CANDIDATE_RELEVANCE_FRACTION=0.6
BGE_CANDIDATE_ANCHOR_FRACTION=0.15
BGE_CANDIDATE_ANCHOR_MIN_CHARS=3
BGE_CANDIDATE_PROVIDER_HEAD_FRACTION=0.25
BGE_CANDIDATE_PROVIDER_HEAD_PER_SOURCE=5
BGE_RERANKER_ENABLED=1
BGE_RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
BGE_RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
BGE_RERANKER_DEVICE=auto
BGE_RERANKER_USE_FP16=1
BGE_RERANKER_BATCH_SIZE=8
BGE_RERANKER_MAX_LENGTH=384
BGE_RERANKER_TOP_N=40
BGE_RERANKER_CROSS_RANK_WEIGHT=0.65
BGE_RERANKER_FACET_RANK_WEIGHT=0.15
BGE_RERANKER_HEAD_PROTECT=3
BGE_RERANKER_CACHE_SIZE=8192
BGE_RERANKER_REQUIRED=1

# --- PaSa 7B Selector (optional EvidRank fusion signal) ---
# Official bytedance-research/pasa-7b-selector scored as P("True") on the
# get_selected template. 4-bit load ~5GB VRAM + ~38s; opt-in for A/B lab only.
PASA_SELECTOR_ENABLED=0
PASA_SELECTOR_REQUIRED=0
PASA_SELECTOR_MODEL_PATH=models/pasa-7b-selector-sharded
PASA_SELECTOR_TOP_N=80
PASA_SELECTOR_BATCH_SIZE=8
PASA_SELECTOR_MAX_LENGTH=2048
PASA_SELECTOR_RANK_WEIGHT=0.30
PASA_SELECTOR_PROTECT_HEAD=1
PASA_SELECTOR_USE_4BIT=1
# Load-time memory bounds (4-bit load materialises bf16; caps prevent OOM)
PASA_SELECTOR_MAX_CPU_MEMORY_GB=6.0
PASA_SELECTOR_MAX_GPU_MEMORY_GB=11.0

# --- PaSa Crawler query fusion (auxiliary variant source) ---
# Merges pre-generated crawler queries (backend/scripts/generate_crawler_queries.py)
# into the LLM-intent understanding as EXTRA variants. include_adaptive adds the
# coverage-gap follow-up set (direction 1 adaptive retrieval).
CRAWLER_QUERY_FUSION_ENABLED=0
CRAWLER_QUERY_INCLUDE_ADAPTIVE=0
CRAWLER_QUERY_CACHE_PATH=.modeling-audit/crawler_queries_cache.json
CRAWLER_QUERY_MAX_VARIANTS=6
RAG_EMBEDDING_DIM=1024
RAG_TOP_K=5
HYBRID_RECALL_LIMIT=50
RRF_K=60

# --- Feature 3 / EvidRank ---
EVIDRANK_ENABLED=1
# recall_first：未知证据保留、冲突才待核验；strict：未知关键证据也待核验
EVIDRANK_DECISION_POLICY=recall_first
EVIDRANK_EVIDENCE_TOP_K=5
EVIDRANK_EVIDENCE_POOL_MULTIPLIER=1
EVIDRANK_HIGH_RANK_CUTOFF=5
EVIDRANK_DEFAULT_FACET_TARGET=1
EVIDRANK_THRESHOLD_VERSION=evidrank-v1-rank-evidence-rules
EVIDRANK_THRESHOLD_PROFILE=
EVIDRANK_EVIDENCE_LLM_ENABLED=1
EVIDRANK_EVIDENCE_LLM_MODEL=glm-4-flash
EVIDRANK_EVIDENCE_PROMPT_VERSION=evidence-facet-v2-json-batch
EVIDRANK_EVIDENCE_MAX_TOKENS=1600
EVIDRANK_EVIDENCE_BATCH_SIZE=5
EVIDRANK_EVIDENCE_MAX_RETRIES=0
EVIDRANK_EVIDENCE_TIMEOUT_SECONDS=20

# Local benchmark data. May point to paper-dataset, pasa-dataset, the new
# dataset package, or its eval directory. ~/Downloads/dataset is auto-detected.
PAPER_TEST_DATASET_ROOT=
PAPER_TEST_FAST_MODE=1
PAPER_TEST_MIN_QUERY_VARIANTS=2
PAPER_TEST_BGE_M3_CANDIDATE_LIMIT=120
PAPER_TEST_BGE_M3_MAX_CANDIDATE_LIMIT=160
PAPER_TEST_BGE_RERANKER_TOP_N=80
# Benchmark-only override for the PaSa selector scoring pool (fast mode).
PAPER_TEST_PASA_SELECTOR_TOP_N=80

# --- App ---
USE_MOCK=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
BACKEND_PORT=8000
FRONTEND_PORT=8080
VITE_API_BASE=

# Local hybrid index backend; enable retrieval after building the index.
ACADEMIC_VECTOR_BACKEND=faiss
ACADEMIC_LOCAL_VECTOR_INDEX_DIR=
ACADEMIC_LOCAL_VECTOR_MULTIVARIANT=1
